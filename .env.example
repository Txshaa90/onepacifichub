# Supabase Configuration (REQUIRED for authentication)
# Get these values from: https://app.supabase.com/project/_/settings/api
# 
# ⚠️ IMPORTANT: 
# - Authentication will NOT work without these values
# - Copy this file to .env and add your actual keys
# - Never commit .env file to git (it's in .gitignore)
# - For Vercel deployment, add these in: Settings → Environment Variables

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Shopify Storefront API (REQUIRED for headless products + cart)
# For example: onepacifichub.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_API_TOKEN=your-storefront-access-token
# Shopify API version (change if needed)
VITE_SHOPIFY_STOREFRONT_API_VERSION=2024-04

# Example:
# VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
    